
QMainWindow {
    background-color: #ffffff;
    font-family: Lato;
    font-size: 14px;
}

/* Face and size belong to the page. A font here would replace them on the next theme reload. */
QTextEdit {
    background-color: #ffffff;
    color: #1A1714;
    selection-background-color: rgba(166, 132, 91, 0.30);
    selection-color: #1A1714;
    padding: 18px 22px 12px 22px;
    border: none;
}

QPushButton {
    background-color: transparent;
    color: #8A8178;
    border: none;
    padding: 6px 10px;
    font-family: Lato;
    font-size: 13px;
}

QPushButton:hover {
    color: #1A1714;
}

QWidget#bottomNav {
    background-color: #ffffff;
    border-top: 1px solid rgba(26, 23, 20, 0.09);
}

QWidget#sidebar {
    background-color: #ffffff;
    width: 200px;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QLabel {
    color: #8A8178;
    font-size: 12px;
}

QLabel:hover {
    color: #1A1714;
}

/* Fix for text direction */
QTextEdit::document {
    text-direction: ltr;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: rgba(166, 132, 91, 0.42);
    min-height: 28px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}
